{
  "name": "te-liet",
  "version": "0.1.0",
  "description": "Tê Liệt — 3D multiplayer social hub foundation",
  "scripts": {
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:game": "tsx watch apps/game/src/index.ts",
    "dev:web": "vite apps/web --host 0.0.0.0",
    "build": "tsc --noEmit && vite build apps/web && node scripts/build-server.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts",
    "spike": "tsx scripts/spike.ts",
    "bots": "tsx scripts/bots.ts",
    "keys": "tsx scripts/gen-ticket-keys.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "start:api": "node dist/server/api.mjs",
    "start:game": "node dist/server/game.mjs",
    "start:migrate": "node dist/server/migrate.mjs"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@colyseus/core": "0.18.27",
    "@colyseus/redis-driver": "0.18.7",
    "@colyseus/redis-presence": "0.18.6",
    "@colyseus/schema": "5.0.45",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "better-auth": "1.7.18",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.16",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playcanvas": "2.23.3",
    "prom-client": "15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@gltf-transform/core": "4.5.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  }
}
