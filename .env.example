NODE_ENV=development
# Khóa vé vào game: tạo bằng `npm run -s keys`. API cần TICKET_PRIVATE_JWK, game chỉ cần TICKET_PUBLIC_JWKS.
# Bỏ trống khi dev: API, game và bot tự dùng chung khóa dev trong .dev-keys/ (production thì bắt buộc).
TICKET_PRIVATE_JWK=
TICKET_PUBLIC_JWKS=
# Số proxy đứng trước API (1 khi sau một Nginx), hoặc danh sách IP/CIDR của proxy. Không đặt = không tin proxy.
TRUST_PROXY=
DATABASE_URL=postgres://te_liet:local_only@localhost:5432/te_liet
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173
# Máy public / close test (compose.public.yaml)
# Tên miền trỏ về máy, vd. 203-0-113-7.sslip.io (sslip.io free, không cần mua tên miền).
SITE_HOST=
# Mật khẩu Postgres cho máy public (thay cho local_only của bản local).
POSTGRES_PASSWORD=
# Để trống = ai cũng vào được. Đặt mã thì chỉ người có mã mới lấy được vé. Gửi link https://<host>/?invite=<mã>.
INVITE_CODE=
# Số request mỗi phút cho một IP ở API (mặc định 20; close test nên 120 vì nhiều người có thể chung mạng).
GUEST_RATE_LIMIT=

# Optional server-only T1 results feed. Never use VITE_ for credentials.
MATCH_FEED_ENABLED=false
PANDASCORE_TOKEN=
# Verify the primary LoL team through /lol/teams; do not guess.
PANDASCORE_T1_TEAM_ID=

# Bind local-only API with 127.0.0.1; default remains 0.0.0.0 for containers.
API_HOST=
API_PORT=

# Dormant community progression: do not enable until persistent guest sessions are approved.
# Requires db/003_progression.sql + db/004_cave_stalls.sql and one exact WEB_ORIGIN.
PROGRESSION_ENABLED=false
# Optional official video stays disabled until a verified embed source is configured.
VITE_MATCH_VIDEO_ENABLED=false
VITE_MATCH_VIDEO_OFFICIAL_VERIFIED=false
VITE_MATCH_VIDEO_URL=
